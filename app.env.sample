# BigBlueButton (Greenlight frontend) - Web conferencing frontend
# Copy to app.env and fill in your values

# Timezone
TZ=America/New_York

# Hostname
BASE_HOST_NAME=$HOSTNAME

# BigBlueButton server connection
BBB_ENDPOINT=https://bbb.example.com/bigbluebutton/api
BBB_SECRET=changeme_bbb_shared_secret

# Database credentials
DB_CREATE_DATABASE_NAME=greenlight
DB_USER_NAME=greenlight
DB_USER_PASS=changeme_db_password

# Application secret key (must be at least 32 characters)
APP_SECRET_KEY=changeme_secret_key_min_32_chars
